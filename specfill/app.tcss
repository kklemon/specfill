PasteScreen #instructions {
    padding: 1 2;
    color: $text-muted;
}

PasteScreen #seed {
    margin: 0 2;
    height: 1fr;
}

PasteScreen #custom_label {
    padding: 1 2 0 2;
    color: $text-muted;
}

PasteScreen #custom_instructions {
    margin: 0 2;
}

#actions {
    height: auto;
    padding: 1 2;
    align-horizontal: right;
}

#actions Button {
    margin-left: 2;
}

#status {
    padding: 1 2;
    color: $text-muted;
}

#activity {
    padding: 0 2;
    height: auto;
    color: $accent;
}

#wizard_form {
    padding: 1 2;
}

#wizard_title {
    padding-bottom: 1;
    text-style: bold;
}

#wizard_form Label {
    margin-top: 1;
    color: $text-muted;
}

#wizard_form RadioSet {
    background: transparent;
    border: none;
    padding: 0;
    height: auto;
}

#wizard_form Input {
    max-width: 80;
}

#card_slot {
    height: 1fr;
    margin: 0 2;
    overflow-y: auto;
}

QuestionCard {
    height: auto;
    padding: 1 2;
    border: round $primary;
}

QuestionCard #question_header {
    color: $accent;
    text-style: bold;
}

QuestionCard #question_text {
    padding-bottom: 1;
    text-style: bold;
}

QuestionCard RadioSet, QuestionCard SelectionList {
    background: transparent;
    border: none;
    padding: 0;
    height: auto;
    max-height: 16;
}

QuestionCard #other {
    margin-top: 1;
}

#loader {
    height: 3;
    display: none;
}

InterviewScreen.loading #loader {
    display: block;
}

InterviewScreen.loading #card_slot,
InterviewScreen.loading #actions {
    display: none;
}

#error_box {
    margin: 1 2;
    padding: 1 2;
    border: round $error;
    color: $error;
    height: auto;
    display: none;
}

InterviewScreen.errored #error_box {
    display: block;
}

InterviewScreen.errored #card_slot {
    display: none;
}

ResultScreen #result_scroll {
    height: 1fr;
    margin: 0 2;
}

ResultScreen #result {
    padding: 1 2;
}
